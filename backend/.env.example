# --- Server ---
# No setees PORT en Vercel: la plataforma lo asigna, y un valor fijo hace que
# la función escuche en el puerto equivocado y termine en timeout.
PORT=3000
NODE_ENV=development

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database / Prisma ---
# DATABASE_URL: transaction pooler (6543) — queries de runtime.
# DIRECT_URL:   session pooler (5432) — solo migraciones. El DDL no corre sobre
#               un pooler en modo transacción.
# NO uses db.<project-ref>.supabase.co: ese host es IPv6-only, así que falla
# desde entornos IPv4 como CI o Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Anthropic ---
# El modelo se elige por código, no por env: ver scripts/spike/run.js y AGENTS.md.
ANTHROPIC_API_KEY=

# --- Apify ---
# El actor NQEbFd0PlD0PJDKmW extrae red y publicaciones de un perfil.
APIFY_TOKEN=
APIFY_ACTOR_ID=NQEbFd0PlD0PJDKmW

# --- Fuente publica (recomendada): no necesita sesion de LinkedIn ---
# La red se arma desde quien comenta y reacciona en los posts publicos del
# perfil. Un post publico y sus comentarios se ven deslogueado, asi que esta
# via no le pide la cookie de su cuenta a nadie.
# Van en pareja: sin el actor de posts, el de engagement no tiene que mirar.
APIFY_POSTS_ACTOR_ID=
APIFY_POSTS_ACTOR_INPUT=
APIFY_ENGAGEMENT_ACTOR_ID=
APIFY_ENGAGEMENT_ACTOR_INPUT=

# --- Fuente con sesion (opt-in, ultimo recurso) ---
# Un scraper de la lista de conexiones. Esa lista NO es publica: este camino
# exige la cookie li_at de una cuenta real. Solo se usa si no hay ninguna de
# las otras dos fuentes.
APIFY_CONNECTIONS_ACTOR_ID=
APIFY_CONNECTIONS_ACTOR_INPUT=
