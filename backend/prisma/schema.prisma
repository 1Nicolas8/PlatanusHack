// Source of truth for the database schema.
//
// Prisma is used for MIGRATIONS ONLY. There is no Prisma Client in this repo:
// the data layer is @supabase/supabase-js inside the repositories.
// Do not import PrismaClient — it is not installed.
//
// Add your models below, then follow the flow in AGENTS.md:
//   1. edit this file
//   2. npm run db:migrate:diff   -> prints the SQL delta against the live DB
//   3. save it as prisma/migrations/<YYYYMMDDHHMMSS>_<description>/migration.sql
//   4. npm run db:migrate
//
// CHECK constraints cannot be expressed here — write them by hand at the end
// of the migration.sql that introduces them.

datasource db {
  provider = "postgresql"
}

model Conexion {
  id             BigInt            @id @default(autoincrement()) @db.BigInt
  /// Dueño de la red. Sin esto todos los perfiles comparten los mismos datos.
  perfilUrl      String            @map("perfil_url") @db.Text
  linkedinUrl    String?           @map("linkedin_url") @db.Text
  nombre         String            @db.Text
  headline       String?           @db.Text
  fechaContacto  DateTime?         @map("fecha_contacto") @db.Date
  estadoBusqueda String?           @map("estado_busqueda") @db.Text
  arquetipoId    BigInt?           @map("arquetipo_id") @db.BigInt
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  reacciones     Reaccion[]
  arquetipo      Arquetipo?        @relation(fields: [arquetipoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  agente         AgenteSimulacion?
  perfil         PerfilEnriquecido?

  @@unique([perfilUrl, nombre, fechaContacto])
  @@unique([perfilUrl, linkedinUrl])
  @@map("conexiones")
}

/// Lo que el scrapeo de perfil trae de una conexion, mas alla del headline.
///
/// Vive en su propia tabla y no en `conexiones` porque es opcional y caro: el
/// enriquecimiento es un scrape por persona y solo se le hace a los que el
/// plan de `warmth/enrichment.service` selecciona. Una conexion sin fila aca
/// es normal, no un error.
model PerfilEnriquecido {
  conexionId    BigInt   @id @map("conexion_id") @db.BigInt
  actorRunId    String?  @map("actor_run_id") @db.Text
  descripcion   String?  @db.Text
  cargoActual   String?  @map("cargo_actual") @db.Text
  empresaActual String?  @map("empresa_actual") @db.Text
  sector        String?  @db.Text
  ubicacion     String?  @db.Text
  /// [{ cargo, empresa, desde, hasta }]
  experiencia   Json?    @db.JsonB
  /// [{ institucion, titulo, anio }]
  educacion     Json?    @db.JsonB
  /// Lo que publica o comparte: [{ texto, fecha, tipo, reacciones }].
  publicaciones Json?    @db.JsonB
  /// Lo que comparte CON EL DUEÑO de la red: { empresas, instituciones, conexionesMutuas, grupos }.
  enComun       Json?    @map("en_comun") @db.JsonB
  seguidores    Int?
  conexiones    Int?     @map("conexiones")
  fotoUrl       String?  @map("foto_url") @db.Text
  linkedinUrl   String?  @map("linkedin_url") @db.Text
  gradoGrafo    Int?     @map("grado_grafo")
  esIcp         Boolean? @map("es_icp")
  confianzaIcp  Decimal? @map("confianza_icp") @db.Decimal
  razonIcp      String?  @map("razon_icp") @db.Text
  /// Que scraper lo trajo. Sin esto no se puede auditar un dato raro.
  fuente        String?  @db.Text
  extraidoEn    DateTime @default(now()) @map("extraido_en") @db.Timestamptz(6)
  conexion      Conexion @relation(fields: [conexionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  audiencia     AudienciaActor? @relation(fields: [actorRunId], references: [runId], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorRunId])
  @@map("perfiles_enriquecidos")
}

/// Snapshot persistido de la audiencia entregada por una corrida de Apify.
model AudienciaActor {
  runId          String              @id @map("run_id") @db.Text
  perfilUrl      String              @map("perfil_url") @db.Text
  totalContactos Int                 @map("total_contactos")
  iniciadaEn     DateTime            @map("iniciada_en") @db.Timestamptz(6)
  terminadaEn    DateTime?           @map("terminada_en") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  perfiles       PerfilEnriquecido[]

  @@index([perfilUrl, iniciadaEn])
  @@map("audiencias_actor")
}

/// Una evaluacion de copy por el panel. Es la unidad de trazabilidad: cabecera
/// de la corrida, con sus turnos colgando.
model CorridaPanel {
  id          String       @id @db.Text
  perfilUrl   String       @map("perfil_url") @db.Text
  copy        String       @db.Text
  icp         String?      @db.Text
  panel       Int
  rondas      Int
  iteraciones Int
  modelo      String       @db.Text
  semilla     String       @db.Text
  score       Decimal?     @db.Decimal
  desviacion  Decimal?     @db.Decimal
  convergio   Boolean?
  veredicto   String?      @db.Text
  mejoras     Json?        @db.JsonB
  resumen     Json?        @db.JsonB
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  turnos      TurnoPanel[]

  @@index([perfilUrl])
  @@map("corridas_panel")
}

/// Lo que hizo un agente en una ronda de una iteracion, con el prompt y la
/// respuesta cruda. Guardar el prompt es lo que permite explicar despues por
/// que un agente dijo lo que dijo.
model TurnoPanel {
  id             BigInt       @id @default(autoincrement()) @db.BigInt
  corridaPanelId String       @map("corrida_panel_id") @db.Text
  iteracion      Int
  ronda          Int
  conexionId     BigInt?      @map("conexion_id") @db.BigInt
  nombre         String       @db.Text
  headline       String?      @db.Text
  accion         String       @db.Text
  score          Int
  objecion       String?      @db.Text
  comentario     String?      @db.Text
  razon          String?      @db.Text
  /// Nombres de los pares cuyo comentario vio antes de decidir.
  vio            Json?        @db.JsonB
  prompt         String       @db.Text
  respuesta      Json?        @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  corrida        CorridaPanel @relation(fields: [corridaPanelId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([corridaPanelId, iteracion, ronda])
  @@map("turnos_panel")
}

model Arquetipo {
  id                 BigInt             @id @default(autoincrement()) @db.BigInt
  nombre             String             @unique @db.Text
  descripcion        String             @db.Text
  awareness          String             @db.Text
  objeciones         String             @db.Text
  painPoints         String             @map("pain_points") @db.Text
  sensibilidadPrecio String             @map("sensibilidad_precio") @db.Text
  intencionCompra    String             @map("intencion_compra") @db.Text
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  conexiones         Conexion[]
  agentes            AgenteSimulacion[]

  @@map("arquetipos")
}

model AgenteSimulacion {
  id                   BigInt              @id @default(autoincrement()) @db.BigInt
  conexionId           BigInt              @unique @map("conexion_id") @db.BigInt
  arquetipoId          BigInt?             @map("arquetipo_id") @db.BigInt
  nivel                String              @db.Text
  reaccionesObservadas Int                 @default(0) @map("reacciones_observadas")
  umbralUsado          Int                 @map("umbral_usado")
  semilla              Int?
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  conexion             Conexion            @relation(fields: [conexionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  arquetipo            Arquetipo?          @relation(fields: [arquetipoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  alcancesEstimados    AlcanceAgentePost[]
  calibraciones        CalibracionAgente[]

  @@map("agentes_simulacion")
}

model Post {
  id                    BigInt              @id @default(autoincrement()) @db.BigInt
  /// Dueño de la publicacion.
  perfilUrl             String              @map("perfil_url") @db.Text
  titulo                String?             @db.Text
  texto                 String              @db.Text
  fecha                 DateTime?           @db.Date
  tipo                  String?             @db.Text
  impresiones           Int?
  totalReacciones       Int?                @map("total_reacciones")
  alcanzados            Int?
  pctEnRed              Decimal?            @map("pct_en_red") @db.Decimal
  pctFueraRed           Decimal?            @map("pct_fuera_red") @db.Decimal
  compartidos           Int?
  guardados             Int?
  interaccionesSociales Int?                @map("interacciones_sociales")
  visualizacionesVideo  Int?                @map("visualizaciones_video")
  visualizacionesPerfil Int?                @map("visualizaciones_perfil")
  seguidoresObtenidos   Int?                @map("seguidores_obtenidos")
  orden                 Int
  ordenCronologico      Int                 @map("orden_cronologico")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  reacciones            Reaccion[]
  particiones           ParticionPost[]
  alcancesEstimados     AlcanceAgentePost[]

  @@unique([perfilUrl, orden])
  @@unique([perfilUrl, ordenCronologico])
  @@map("posts")
}

model ParticionPost {
  esquema String @db.Text
  postId  BigInt @map("post_id") @db.BigInt
  rol     String @db.Text
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([esquema, postId])
  @@index([esquema, rol])
  @@map("particiones_posts")
}

model CorridaCalibracion {
  id                      String              @id @db.Text
  esquemaParticion        String              @map("esquema_particion") @db.Text
  modeloAlcanceHabilitado Boolean             @map("modelo_alcance_habilitado")
  pctEnRedSupuesto        Decimal             @map("pct_en_red_supuesto") @db.Decimal
  fuerzaPrior             Decimal             @map("fuerza_prior") @db.Decimal
  supuestoAlcance         String              @map("supuesto_alcance") @db.Text
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  alcances                AlcanceAgentePost[]
  calibraciones           CalibracionAgente[]

  @@map("corridas_calibracion")
}

model AlcanceAgentePost {
  corridaId        String             @map("corrida_id") @db.Text
  agenteId         BigInt             @map("agente_id") @db.BigInt
  postId           BigInt             @map("post_id") @db.BigInt
  exposureProb     Decimal            @map("exposure_prob") @db.Decimal
  impresionesEnRed Decimal            @map("impresiones_en_red") @db.Decimal
  fuenteAlcance    String             @map("fuente_alcance") @db.Text
  supuestoAlcance  String             @map("supuesto_alcance") @db.Text
  corrida          CorridaCalibracion @relation(fields: [corridaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  agente           AgenteSimulacion   @relation(fields: [agenteId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  post             Post               @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([corridaId, agenteId, postId])
  @@index([postId])
  @@map("alcances_agentes_posts")
}

model CalibracionAgente {
  corridaId        String             @map("corrida_id") @db.Text
  agenteId         BigInt             @map("agente_id") @db.BigInt
  tasaCalibrada    Decimal            @map("tasa_calibrada") @db.Decimal
  tasaArquetipo    Decimal            @map("tasa_arquetipo") @db.Decimal
  exitos           Int
  fallosPonderados Decimal            @map("fallos_ponderados") @db.Decimal
  kUsado           Decimal            @map("k_usado") @db.Decimal
  esquemaParticion String             @map("esquema_particion") @db.Text
  supuestoAlcance  String             @map("supuesto_alcance") @db.Text
  corrida          CorridaCalibracion @relation(fields: [corridaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  agente           AgenteSimulacion   @relation(fields: [agenteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([corridaId, agenteId])
  @@map("calibraciones_agentes")
}

model Reaccion {
  id              BigInt    @id @default(autoincrement()) @db.BigInt
  postId          BigInt    @map("post_id") @db.BigInt
  conexionId      BigInt?   @map("conexion_id") @db.BigInt
  nombre          String    @db.Text
  headline        String?   @db.Text
  tipo            String    @db.Text
  subtipo         String?   @db.Text
  grado           Int?
  textoComentario String?   @map("texto_comentario") @db.Text
  enConexiones    Boolean   @map("en_conexiones")
  post            Post      @relation(fields: [postId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  conexion        Conexion? @relation(fields: [conexionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([postId, nombre, tipo])
  @@map("reacciones")
}
